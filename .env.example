# Copy this file to .env and fill in your values.
#
# The app can use several AI providers and fails over between them when one
# is rate limited, out of quota, down or misconfigured (see providers.py).
# A provider is used only if its key is set -- one key is enough to run.
# Defaults: gpt-oss-120b (Groq, Hugging Face),
# Nemotron 3 Super 120B free (OpenRouter), gpt-oss-20b (NVIDIA).

# Order to try them in (default shown). Add "google" to use Gemini.
LLM_PROVIDERS=groq,openrouter,nvidia,huggingface

# 1. Groq -- https://console.groq.com/keys
#    (LLM_API_KEY is also accepted as the Groq key, for older .env files.)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional: a second Groq model, tried last. Each Groq model has its own
# daily quota, so this adds capacity.
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# 2. OpenRouter -- https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# 3. NVIDIA (build.nvidia.com) -- https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=
# Default: Nemotron 3 Super (120B, 12B active, 1M context, strong agentic/RAG)
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# Optional second NVIDIA model for fallback (e.g., Nemotron 3 Ultra for harder queries)
# NVIDIA_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# 4. Hugging Face Inference Providers -- https://huggingface.co/settings/tokens
#    (a fine-grained token with "Make calls to Inference Providers")
HF_TOKEN=
HUGGINGFACE_MODEL=openai/gpt-oss-120b

# 5. Optional, opt-in: Google AI Studio (Gemini API) --
#    https://aistudio.google.com/apikey. Add "google" to LLM_PROVIDERS.
GEMINI_API_KEY=
GOOGLE_MODEL=gemini-3.6-flash

# Advanced: <NAME>_BASE_URL overrides a provider's endpoint, and
# LLM_BASE_URL / LLM_MODEL still configure the first (Groq) slot, e.g. to
# point it at any other OpenAI-compatible server.

# --- Observability (all optional) ---
# Log verbosity: DEBUG | INFO | WARNING | ERROR (default INFO).
LOG_LEVEL=INFO
# Error reporting via Sentry turns on ONLY if a DSN is set; nothing is sent
# otherwise. User document content is never attached (send_default_pii=False).
SENTRY_DSN=
SENTRY_TRACES_RATE=0
APP_ENV=production

# --- Rate limiting & security (all optional, safe defaults) ---
# Trusted proxy CIDRs (comma-separated) whose X-Real-IP headers are honoured.
# Default: loopback only (127.0.0.0/8, ::1/128). Behind Docker/Nginx, add the
# Docker bridge network, e.g. TRUSTED_PROXIES=172.17.0.0/16,127.0.0.0/8,::1/128
TRUSTED_PROXIES=127.0.0.0/8,::1/128

# Maximum total chunks across all documents in one session (503 when exceeded).
# Default: 75000. Each chunk is ~512 chars; this caps memory per session.
MAX_TOTAL_CHUNKS=75000

# Minimum retrieval score for non-overview questions to be used as context.
# Below this floor, the question receives empty passages and the model refuses.
# Default: 0.30 (calibrated from retrieval_eval.py: irrelevant 95th %ile 0.44,
# relevant median 0.45). Increase for stricter abstention; decrease for recall.
RETRIEVAL_SCORE_FLOOR=0.30

# Optional eager model load for cold-start latency. If 1, the embedding model
# loads on first use instead of lazily. Default: 0 (lazy).
PREFETCH_MODEL=0
